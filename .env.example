# ─────────────────────────────────────────────────────────────────────────
# CORTEXA — environment configuration template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`,
# real credentials, keys or connection strings to version control.
# Every secret below is read server-side only; none are shipped to the client.
# ─────────────────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/cortexa?schema=public

# ── Authentication & session secrets ─────────────────────────────────────
# Used to sign session cookies / JWTs. Generate with a CSPRNG, 256+ bits.
JWT_SECRET=replace-with-a-long-random-string
# Rotation key used when re-encrypting stored secrets.
SECRET_KEY_BASE=replace-with-another-long-random-string

# ── Password hashing (Argon2id) ──────────────────────────────────────────
# Tuning follows OWASP guidance; leave defaults unless you have a reason.
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4

# ── Object storage (document vault) — one of: Supabase / S3 / R2 / Azure ──
STORAGE_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# S3-compatible (AWS S3, Cloudflare R2, MinIO)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Signed URL lifetime for protected document access (seconds)
SIGNED_URL_TTL_SECONDS=300

# ── Transactional email (verification codes, reminders, approvals) ──────
# Provider abstraction: smtp | resend | postmark | ses
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Cortexa <no-reply@example.org>"

# ── Optional: external calendar / mail integrations ──────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Optional: AI assistant provider ──────────────────────────────────────
AI_PROVIDER=
AI_API_KEY=

# ── Runtime ──────────────────────────────────────────────────────────────
# production | staging | development  (debug tooling disabled in production)
NODE_ENV=production
PORT=3000
# Public origin used in emailed links — must be HTTPS in production.
PUBLIC_ORIGIN=https://registry.example.org

# ── Rate limiting / abuse protection ─────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
